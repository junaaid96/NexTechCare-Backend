# Copy to .env for local development. Never commit real values.
SECRET_KEY=change-me
DEBUG=True
# Neon pooled connection string (runtime). Leave empty to use local SQLite.
DATABASE_URL=
# Neon direct (non-pooled) connection string, used for migrations:
#   USE_UNPOOLED_DB=1 python manage.py migrate
DATABASE_URL_UNPOOLED=
# Comma-separated
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://nextechcare.netlify.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# AI Issue Triage (optional, falls back to rule-based triage when empty)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
